# Google Gemini API key — used for embeddings via langchain-google-genai
GOOGLE_API_KEY=your-gemini-api-key-here

# Groq API key — used for chat (Llama 3.3 70B) via langchain-groq
GROQ_API_KEY=your-groq-api-key-here      # get from console.groq.com/keys

# Tavily API key — used by the web_search tool in the research agents
TAVILY_API_KEY=your-tavily-api-key-here

# Mistral API key — used by the multi-query retriever demo (rag/retrievers/multiquery.py)
MISTRAL_API_KEY=your-mistral-api-key-here

# JWT signing secret — required, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-generated-secret-here

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 7 days)
JWT_EXPIRE_MINUTES=10080

# SQLAlchemy database URL — SQLite file for now, swap to Postgres later
DATABASE_URL=sqlite:///./researchmind.db
