# Copy to .env in the project root, then fill in real values:
#   cp .env.example .env
#
# docker-compose.yml auto-loads .env from this directory and passes these
# through to the backend container's environment.

# Groq API key — used for chat (Llama 3.3 70B) via langchain-groq
GROQ_API_KEY=your-groq-api-key-here

# Google Gemini API key — used for embeddings via langchain-google-genai
GOOGLE_API_KEY=your-gemini-api-key-here

# Tavily API key — used by the web_search tool in the research agents
TAVILY_API_KEY=your-tavily-api-key-here

# Mistral API key — used by the multi-query retriever demo (optional)
MISTRAL_API_KEY=your-mistral-api-key-here

# JWT signing secret — required, no default. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-generated-secret-here
